# Copia este archivo como .env y rellena lo que quieras usar.
# Solo ANTHROPIC_API_KEY es obligatoria; el resto activa funciones extra.

# --- Cerebro (obligatorio) --- https://console.anthropic.com
ANTHROPIC_API_KEY=

# --- Correo (Gmail) ---
# Necesitas una "contraseña de aplicación": https://myaccount.google.com/apppasswords
EMAIL_USUARIO=tu.correo@gmail.com
EMAIL_PASSWORD=
# Para otros proveedores (Outlook: outlook.office365.com / smtp.office365.com)
# EMAIL_IMAP=imap.gmail.com
# EMAIL_SMTP=smtp.gmail.com

# --- Llamadas y WhatsApp (Twilio) --- https://console.twilio.com
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
# Número de Twilio desde el que Jarvis te llama (formato internacional)
TWILIO_NUMERO=+1XXXXXXXXXX
# Tu móvil, en formato internacional
MI_TELEFONO=+34XXXXXXXXX
# Número de WhatsApp de Twilio (por defecto, el del sandbox)
# TWILIO_WHATSAPP=+14155238886
