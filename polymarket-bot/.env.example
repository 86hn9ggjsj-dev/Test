# Copia este archivo como .env:  cp .env.example .env
# Solo ANTHROPIC_API_KEY es obligatoria para Paper Trading.

# ===== Cerebro (Claude) =====
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-opus-5-5

# ===== Modo =====
TRADING_MODE=paper                # paper (por defecto) | live
INITIAL_BANKROLL=50

# ===== TURBO: "modo minero" =====
# Muchos trades pequeños, todo el rato: mercados que resuelven en <= 7 días, criba de
# hasta 150 mercados por ciclo, 10 análisis por ciclo y presupuesto de $10/día.
# NO toca las reglas duras. Cualquier variable de abajo que descomentes manda sobre TURBO.
TURBO=true
# DAILY_API_BUDGET_USD=10         # (turbo 10 · normal 3) tope de gasto diario total en Claude
# TRIAGE_DAILY_BUDGET_USD=2       # (turbo 2 · normal 1) parte reservada a la criba
# MAX_DAYS_TO_RESOLUTION=7        # (turbo 7 · normal 60)
# MAX_EVALUATIONS_PER_CYCLE=10    # (turbo 10 · normal 4) análisis a fondo por ciclo
# TRIAGE_MAX_PER_CYCLE=150        # (turbo 150 · normal 50) mercados cribados por ciclo
# TRIAGE_REFRESH_HOURS=2          # (turbo 2 · normal 6)
# REEVALUATE_AFTER_MINUTES=90     # (turbo 90 · normal 240)
# POSITION_REEVAL_MINUTES=45      # (turbo 45 · normal 60)
# CLAUDE_EFFORT=medium            # (turbo medium · normal high) esfuerzo del analista
# MAX_WEB_SEARCHES=3              # (turbo 3 · normal 5)
# SKEPTIC_EFFORT=low              # (turbo low · normal medium)
# SKEPTIC_WEB_SEARCHES=2          # (turbo 2 · normal 3)
# MIN_VOLUME_24H=500              # (turbo 500 · normal 1000)
VPS_MONTHLY_USD=6.00              # coste de tu VPS, para el contador de supervivencia

# ===== Equipo de agentes =====
TRIAGE_ENABLED=true               # criba barata por lotes antes del analista
TRIAGE_MODEL=claude-opus-5-5
TRIAGE_EFFORT=low
TRIAGE_BATCH=25
TRIAGE_THRESHOLD=0.06
SKEPTIC_ENABLED=true              # segunda opinión que puede vetar
SKEPTIC_MODEL=claude-opus-5-5
FV_SMOOTHING=0.5                  # media móvil del fair value en posiciones abiertas (0 = sin suavizar)
FAST_MODE=true                    # prioriza mercados del tiempo (NOAA) y los que resuelven antes

# ===== Agente CUOTAS: deportes frente a Pinnacle (The Odds API) =====
# Clave en https://the-odds-api.com (plan gratuito: ~500 créditos/mes). Cada refresco cuesta
# nº de deportes × nº de mercados créditos: con 9 deportes × 2 mercados = 18 créditos por refresco.
# Cada 3 h son ~144 créditos/día: el plan gratuito dura ~3 días; para uso continuo hace falta un plan de pago.
SHARP_ENABLED=false
ODDS_API_KEY=
SHARP_BOOKMAKER=pinnacle
SHARP_SPORTS=soccer_uefa_champs_league,soccer_epl,soccer_spain_la_liga,soccer_italy_serie_a,soccer_germany_bundesliga,baseball_mlb,americanfootball_nfl,basketball_nba,icehockey_nhl
SHARP_MARKETS=h2h,totals          # h2h = ganador (con empate), totals = más/menos, spreads = hándicap
SHARP_REFRESH_MINUTES=180
SHARP_SHADOW_EDGE=0.02            # desvíos >= 2 pp se registran en la sombra (solo se opera con > 8 pp)

# ===== Loop =====
LOOP_MINUTES=10
MAX_MARKETS_SCAN=1000

# ===== Reglas duras =====
# Solo se pueden hacer MÁS estrictas; si las aflojas el bot no arranca.
MAX_POSITION_PCT=0.06
MAX_OPEN_POSITIONS=5
MIN_EDGE=0.08
KELLY_FRACTION=0.25
MIN_LIQUIDITY=5000
MIN_HOURS_TO_RESOLUTION=2
MAX_DRAWDOWN=0.40

# ===== Filtros extra =====
MAX_SPREAD=0.05
MIN_CONFIDENCE=medium             # low | medium | high
TAKER_FEE=0

# ===== Salidas =====
EXIT_EDGE=0.02
FV_MOVE_EXIT=0.05
EXIT_HOURS_BEFORE_RESOLUTION=2

# ===== Live Trading (dinero real) — lee README antes =====
LIVE_TRADING_CONFIRM=no           # hay que poner exactamente: yes
POLYMARKET_PRIVATE_KEY=           # clave privada de la wallet que firma (¡nunca la subas a git!)
POLYMARKET_FUNDER=                # dirección de tu wallet proxy de Polymarket (la que ves en tu perfil)
POLYMARKET_SIGNATURE_TYPE=1       # 1 = cuenta con email/Magic · 2 = wallet de navegador (MetaMask) · 0 = EOA directa
MAX_SLIPPAGE=0.02

# ===== Panel web =====
DASHBOARD_HOST=127.0.0.1          # 0.0.0.0 para abrirlo por internet (entonces pon un token)
DASHBOARD_PORT=8080
DASHBOARD_TOKEN=                  # si lo pones: http://IP:8080/?token=...
